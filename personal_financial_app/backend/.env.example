# Copy this file to `.env` and adjust values:  cp .env.example .env
# NEVER commit the real .env — it is gitignored.

# Django
# Required whenever DJANGO_DEBUG is off — startup fails without it. Keep it
# STABLE: it derives the key that encrypts stored AI keys, so changing it
# makes them undecryptable.
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS hardening — only applied when DJANGO_DEBUG is off.
# Turn the redirect off if TLS already terminates in front of Django.
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=86400
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false

# CORS (comma-separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Exchange rates (multi-currency). Server-wide key: rates are the same for
# every account. Free tier at https://www.exchangerate-api.com/ (~1500
# requests/month, which is ample since rates are cached once per day).
# Without it the app still runs; amounts just are not converted.
EXCHANGERATE_API_KEY=
# FX_PROVIDER=exchangerate-api

# AI: optional fallback Gemini key when no per-user key is stored
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Auth rate limits
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour
# Two-factor code attempts (brute-force protection for the 6-digit code)
THROTTLE_MFA=10/min

# Database: sqlite (default) or mysql
DB_ENGINE=sqlite
# DB_NAME=personal_finance
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
