# Copy this file to `.env` and adjust values:  cp .env.example .env
# NEVER commit the real .env — it is gitignored.

# Django (required for anything beyond local dev)
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (comma-separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# AI: optional fallback Gemini key when no per-user key is stored
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Auth rate limits
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour

# Database: sqlite (default) or mysql
DB_ENGINE=sqlite
# DB_NAME=personal_finance
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306
